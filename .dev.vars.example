# Sao chép thành .dev.vars (đã được .gitignore) rồi điền giá trị thật để chạy `npx wrangler dev`
# hoặc `node scripts/dev-server.mjs`. KHÔNG điền giá trị thật vào file .example này (được commit).
CENTER_NAME=Tôi luyện tiếng Việt
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
LANGUAGES=de:Deutsch,en:English
BRAND_COLOR=#e8590c

# Sinh giọng đọc (TTS) cho công cụ admin — tuỳ chọn. Provider: azure | google. Đặt TTS_KEY dạng Secret khi deploy.
# TTS_PROVIDER=azure
# TTS_KEY=...
# TTS_REGION=westeurope
# TTS_VOICES={"vi":{"female":"vi-VN-HoaiMyNeural","male":"vi-VN-NamMinhNeural"}}   (tuỳ chọn; giọng cũng chọn được ở tab Cài đặt của app)

# Dịch tự động + gợi ý emoji cho công cụ admin (Gemini) — tuỳ chọn. Đặt AI_KEY dạng Secret khi deploy (KHÔNG ghi vào wrangler.jsonc).
# Lấy khoá ở Google AI Studio. AI_MODEL không bắt buộc (mặc định gemini-2.5-flash) — đổi khi Google đổi tên/ngừng mô hình.
# AI_KEY=...
# AI_MODEL=gemini-2.5-flash
