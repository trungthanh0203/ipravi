{
  // Worker "Tôi luyện tiếng Việt". MỖI TRUNG TÂM/ADMIN = 1 Worker riêng (đổi "name" cho
  // từng bản triển khai, hoặc để mỗi bản 1 repo/nhánh riêng) + 1 dự án Supabase riêng.
  // Cấu hình theo từng bản (CENTER_NAME, SUPABASE_URL, SUPABASE_ANON_KEY, LANGUAGES,
  // BRAND_COLOR) đặt ở Cloudflare Dashboard → Workers & Pages → <worker> → Settings →
  // Variables — KHÔNG ghi vào file này. "keep_vars" giữ nguyên biến đó khi deploy.
  // "main" KHÔNG được đặt là "_worker.js" (tên dành riêng cho Pages).

  "name": "tiengviet",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "keep_vars": true,
  // Gemini (dịch bằng AI) từ chối theo VỊ TRÍ máy gọi; Worker mặc định chạy ở trung tâm dữ liệu gần người dùng (vd Hồng Kông với người dùng ở Việt Nam)
  // nên bị báo "User location is not supported". Gợi ý vị trí này làm Worker chạy gần vùng AWS us-east-1 (được Gemini hỗ trợ). Chỉ áp cho các
  // đường /api/* (file tĩnh vẫn phục vụ gần người dùng). Không cần AI thì có thể bỏ khối này. Ảnh hưởng: /api/config chậm hơn một chút với người dùng ở xa.
  "placement": { "region": "aws:us-east-1" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
